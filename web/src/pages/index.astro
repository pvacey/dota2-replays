---
// The dynamic replays app: the match list, the scoreboard, the parse progress,
// and the fights figure for a parsed match. The browser talks only to the
// replays backend; the figure DOM is built client-side per PLAN.md contract §7
// (a port of src/figures/fights.ts without the side card).
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/home.css";
import "../styles/prose.css";
import "../styles/figures.css";
import "../styles/fight-player.css";
import mapHalf from "../data/map-half.json";

const points = (list: number[][]) => list.map(([x, y]) => `${x},${y}`).join(" ");
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Barbaric Replays</title>
  </head>
  <body>
    <div class="app">
      <header class="app-head">
        <h1>Simply Barbaric.</h1>
      </header>
      <aside class="app-side" aria-label="Matches">
        <div class="app-side-head">
          <h2>Matches</h2>
          <button type="button" class="app-refresh" data-refresh aria-label="Refresh the match list">↻</button>
        </div>
        <p class="app-note" data-list-note>Loading matches…</p>
        <ul class="match-list" data-matches hidden></ul>
      </aside>
      <main class="app-main">
        <section class="scoreboard" data-scoreboard hidden aria-label="Scoreboard"></section>
        <div class="app-body" data-body>
          <p class="app-note">Loading matches…</p>
        </div>
      </main>
    </div>

    <!-- Contract §7's figure DOM, cloned per match (data-assets and the map
         image href are filled on the clone). No fights-fig-side: figlib
         tolerates its absence. -->
    <template id="fights-fig-tpl">
      <figure class="fig recipe-fig fights-fig" data-recipe-figure="fights" data-assets="" data-pagefind-ignore>
        <div class="fights-fig-controls" data-controls hidden></div>
        <div class="fights-fig-body">
          <svg class="map" viewBox="0 0 1000 1000" role="img" aria-label="The fights on the map">
            <image href="" width="1000" height="1000" preserveAspectRatio="xMidYMid slice"></image>
            <rect class="map-dim" width="1000" height="1000"></rect>
            <polyline class="map-half" points={points(mapHalf.half_line)}></polyline>
            <g data-fights></g>
          </svg>
        </div>
        <div class="fights-fig-strip" data-timeline hidden></div>
        <div class="fights-fig-list" data-list hidden></div>
        <div class="fights-fig-panel" data-panel hidden></div>
      </figure>
    </template>

    <script>
      import type { FightData } from "../lib/fight-playback";
      import type { FightsData } from "../lib/fights-data";
      import type { ItemLanesData } from "../lib/items-lanes";

      interface MatchListItem {
        match_id: number;
        latest_timestamp: string;
      }
      interface PlayerRow {
        player: string;
        hero: string;
        hero_icon: string;
        kills: number;
        deaths: number;
        assists: number;
        net_worth: number;
        total_gold: number | null;
        last_hits: number | null;
        denies: number | null;
        level: number;
        gpm: number;
        xpm: number | null;
        hero_damage: number;
        /** Final build: [icon key, display name] per slot; null for an empty one. */
        items: (ItemSlot | null)[];
        backpack: (ItemSlot | null)[];
        neutral: ItemSlot | null;
        neutral2: ItemSlot | null;
      }
      type ItemSlot = [string, string];
      interface Scoreboard {
        start_time: number | null;
        duration_s: number;
        radiant_win: boolean;
        radiant_score: number;
        dire_score: number;
        turbo: boolean;
        radiant: PlayerRow[];
        dire: PlayerRow[];
      }
      interface MatchInfo {
        match_id: number;
        parsed: boolean;
        parse_error: string | null;
        scoreboard: Scoreboard | null;
        scoreboard_error?: string | null;
      }
      interface ParseStatus {
        stage: string;
        pct: number | null;
        log: string[];
        done: boolean;
        error: string | null;
      }
      type RowState = "fetching" | "error" | boolean;

      const bust = () => `t=${Date.now()}`;
      const text = (s: string) =>
        s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
      const gold = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : `${n}`);
      const note = (msg: string) => {
        const p = document.createElement("p");
        p.className = "app-note";
        p.textContent = msg;
        return p;
      };
      const errorNote = (msg: string) => {
        const p = document.createElement("p");
        p.className = "app-error";
        p.textContent = msg;
        return p;
      };

      const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
      const listEl = $<HTMLUListElement>("[data-matches]");
      const listNote = $<HTMLParagraphElement>("[data-list-note]");
      const scoreboardEl = $<HTMLElement>("[data-scoreboard]");
      const bodyEl = $<HTMLElement>("[data-body]");
      const figureTpl = $<HTMLTemplateElement>("#fights-fig-tpl");
      $<HTMLButtonElement>("[data-refresh]").addEventListener("click", () => void loadList());

      // Two sequence tokens: the list (refresh) and the selection (parse poll,
      // figure load) evolve independently; stale responses are dropped.
      let listSeq = 0;
      let matchSeq = 0;
      let selected: number | null = null;
      let pollTimer: ReturnType<typeof setInterval> | null = null;
      const rowStates = new Map<number, RowState>();

      const stopPoll = () => {
        if (pollTimer !== null) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      };

      // --- The match list ---

      function stateHtml(state: RowState | undefined): string {
        if (state === true) return `<span class="match-done">✓ parsed</span>`;
        if (state === false) return `<span class="match-todo">not parsed</span>`;
        if (state === "error") return `<span class="match-state-err" title="state unknown">—</span>`;
        return `<span class="spinner" role="status" aria-label="Checking"></span>`;
      }

      function updateRowState(id: number): void {
        const box = listEl.querySelector(`[data-match="${id}"] [data-state]`);
        if (box) box.innerHTML = stateHtml(rowStates.get(id));
      }

      async function fillState(id: number): Promise<void> {
        const ticket = listSeq;
        rowStates.set(id, "fetching");
        updateRowState(id);
        let parsed: boolean;
        try {
          const res = await fetch(`/api/matches/${id}?${bust()}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          parsed = ((await res.json()) as MatchInfo).parsed;
        } catch {
          if (ticket !== listSeq) return;
          rowStates.set(id, "error");
          updateRowState(id);
          return;
        }
        if (ticket !== listSeq) return;
        rowStates.set(id, parsed);
        updateRowState(id);
      }

      function rowFor(m: MatchListItem, shared = false): HTMLLIElement {
        const when = new Date(m.latest_timestamp.replace(" ", "T") + "Z");
        const date = shared
          ? "shared"
          : Number.isNaN(when.getTime())
            ? m.latest_timestamp
            : when.toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
        const li = document.createElement("li");
        li.innerHTML =
          `<button type="button" class="match-row" data-match="${m.match_id}" aria-pressed="${String(m.match_id === selected)}">` +
          `<span class="match-row-top"><span class="match-id">${m.match_id}</span>` +
          `<span class="match-state" data-state>${stateHtml(rowStates.get(m.match_id))}</span></span>` +
          `<span class="match-date">${text(date)}</span>` +
          `</button>`;
        li.querySelector("button")!.addEventListener("click", () => selectMatch(m.match_id));
        return li;
      }

      async function loadList(): Promise<void> {
        const ticket = ++listSeq;
        listNote.hidden = false;
        listNote.textContent = "Loading matches…";
        listEl.hidden = true;
        listEl.replaceChildren();
        let items: MatchListItem[];
        try {
          const res = await fetch(`/api/matches?${bust()}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          items = ((await res.json()) as { matches: MatchListItem[] }).matches;
        } catch (err) {
          if (ticket !== listSeq) return;
          const msg = `Could not load matches: ${(err as Error).message}`;
          listNote.textContent = msg;
          if (selected === null) bodyEl.replaceChildren(errorNote(msg));
          return;
        }
        if (ticket !== listSeq) return;
        listNote.hidden = true;
        listEl.hidden = false;
        listEl.replaceChildren(...items.map((m) => rowFor(m)));
        // A shared match outside the recent list rides along as an extra row.
        if (selected !== null && !items.some((m) => m.match_id === selected)) {
          listEl.prepend(rowFor({ match_id: selected, latest_timestamp: "" }, true));
          if (!rowStates.has(selected)) void fillState(selected);
        }
        for (const m of items) void fillState(m.match_id);
        if (selected !== null) return;
        if (items.length === 0) {
          listEl.hidden = true;
          listNote.hidden = false;
          listNote.textContent = "No matches yet.";
          bodyEl.replaceChildren(note("No matches yet."));
          return;
        }
        selectMatch(items[0].match_id);
      }

      // Shareable selection: read once on load, mirrored back on every change
      // (replaceState — no reload, no history entries). Non-numeric ?m= falls
      // back to the newest match.
      const paramId = (): number | null => {
        const raw = new URLSearchParams(location.search).get("m");
        if (raw === null || !/^\d+$/.test(raw)) return null;
        const id = Number(raw);
        return Number.isSafeInteger(id) && id > 0 ? id : null;
      };
      const syncUrl = (id: number): void => {
        const url = new URL(location.href);
        url.searchParams.set("m", `${id}`);
        history.replaceState(null, "", url);
      };

      function selectMatch(id: number): void {
        if (id === selected) return;
        matchSeq += 1;
        stopPoll();
        selected = id;
        syncUrl(id);
        for (const btn of listEl.querySelectorAll<HTMLButtonElement>("[data-match]"))
          btn.setAttribute("aria-pressed", String(Number(btn.dataset.match) === id));
        void loadMatch(id);
      }

      // --- The selected match: scoreboard + body ---

      async function loadMatch(id: number): Promise<void> {
        const ticket = ++matchSeq;
        itemsAbort?.abort();
        itemsAbort = null;
        scoreboardEl.hidden = true;
        scoreboardEl.replaceChildren();
        bodyEl.replaceChildren(note("Loading match…"));
        let info: MatchInfo;
        try {
          const res = await fetch(`/api/matches/${id}?${bust()}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          info = (await res.json()) as MatchInfo;
        } catch (err) {
          if (ticket !== matchSeq) return;
          bodyEl.replaceChildren(note(`Could not load match ${id}: ${(err as Error).message}`));
          return;
        }
        if (ticket !== matchSeq) return;
        rowStates.set(id, info.parsed);
        updateRowState(id);
        renderScoreboard(info);
        await showMatchBody(id, info);
      }

      function teamTable(side: "radiant" | "dire", rows: PlayerRow[], winner: boolean, kills: number): string {
        const cells = (p: PlayerRow, i: number) =>
          `<tr data-side="${side}" data-i="${i}" role="button" tabindex="0" aria-pressed="false" aria-label="Full match stats for ${text(p.player)}">` +
          `<td class="sb-player">${text(p.player)}</td>` +
          `<td class="sb-hero"><img class="sb-icon sb-icon--${side}" src="/data/icons/heroes/${text(p.hero_icon)}.png" alt="" width="26" height="26" loading="lazy"><span>${text(p.hero)}</span></td>` +
          `<td class="num">${p.kills}</td><td class="num">${p.deaths}</td><td class="num">${p.assists}</td>` +
          `<td class="num">${gold(p.net_worth)}</td><td class="num">${p.level}</td><td class="num">${p.gpm}</td><td class="num">${gold(p.hero_damage)}</td>` +
          `</tr>`;
        return (
          `<section class="sb-team">` +
          `<h2 class="sb-head sb-head--${side}">${side === "radiant" ? "Radiant" : "Dire"}` +
          `<span class="sb-score">${kills}</span>` +
          `${winner ? `<span class="sb-winner">Winner</span>` : ""}</h2>` +
          `<table class="sb-table"><thead><tr>` +
          `<th>Player</th><th>Hero</th><th class="num">K</th><th class="num">D</th><th class="num">A</th>` +
          `<th class="num">Net</th><th class="num">Lvl</th><th class="num">GPM</th><th class="num">Dmg</th>` +
          `</tr></thead><tbody>${rows.map((p, i) => cells(p, i)).join("")}</tbody></table>` +
          `</section>`
        );
      }

      function whenLabel(start: number | null): string {
        if (start === null || !Number.isFinite(start)) return "";
        const d = new Date(start * 1000);
        if (Number.isNaN(d.getTime())) return "";
        return d.toLocaleString(undefined, {
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      // The player card: the picked row, and the board it reads from. A fresh
      // scoreboard (a new match) closes whatever was open.
      let currentBoard: Scoreboard | null = null;
      let cardSel: { side: "radiant" | "dire"; i: number } | null = null;

      function renderScoreboard(info: MatchInfo): void {
        const sb = info.scoreboard;
        currentBoard = sb;
        cardSel = null;
        if (!sb) {
          if (!info.scoreboard_error) return;
          scoreboardEl.hidden = false;
          scoreboardEl.innerHTML = `<p class="sb-error">${text(info.scoreboard_error)}</p>`;
          return;
        }
        const when = whenLabel(sb.start_time);
        scoreboardEl.hidden = false;
        scoreboardEl.innerHTML =
          `<div class="sb-bar">` +
          `<span class="sb-when">${text(when ? `${when} - Match ${info.match_id}` : `Match ${info.match_id}`)}</span>` +
          `<span class="sb-meta">` +
          `<span class="sb-dur">${mmss(sb.duration_s)}</span>` +
          (sb.turbo ? `<span class="tag-turbo">TURBO</span>` : "") +
          `</span>` +
          `</div>` +
          `<div class="sb-teams">` +
          teamTable("radiant", sb.radiant, sb.radiant_win, sb.radiant_score) +
          teamTable("dire", sb.dire, !sb.radiant_win, sb.dire_score) +
          `</div>` +
          `<div class="sb-card" data-card hidden></div>`;
      }

      // --- The player card: full match stats and the final build ---

      function statChip(label: string, value: string): string {
        return `<span class="sb-stat"><b>${value}</b><i>${label}</i></span>`;
      }

      function slotHtml(slot: ItemSlot | null, extra: string): string {
        if (!slot) return `<span class="sb-slot sb-slot--empty ${extra}" aria-hidden="true"></span>`;
        const [key, name] = slot;
        return (
          `<img class="sb-slot ${extra}" src="/data/icons/items/${text(key)}.png" ` +
          `alt="${text(name)}" title="${text(name)}" width="32" height="32" loading="lazy">`
        );
      }

      function playerCardHtml(p: PlayerRow, side: "radiant" | "dire"): string {
        const num = (v: number | null | undefined) =>
          v === null || v === undefined ? "—" : String(v);
        const sum = (v: number | null | undefined) => (v === null || v === undefined ? "—" : gold(v));
        const lh =
          p.last_hits === null || p.last_hits === undefined
            ? "—"
            : `${p.last_hits}/${p.denies ?? 0}`;
        const group = (cls: string, slots: (ItemSlot | null)[] | undefined) =>
          `<span class="sb-slot-group ${cls}">${(slots ?? []).map((s) => slotHtml(s, cls === "sb-slot-group--back" ? "sb-slot--back" : "")).join("")}</span>`;
        return (
          `<div class="sb-card-head">` +
          `<img class="sb-icon sb-icon--${side}" src="/data/icons/heroes/${text(p.hero_icon)}.png" alt="" width="30" height="30">` +
          `<span class="sb-card-name">${text(p.player)}</span>` +
          `<span class="sb-card-hero">${text(p.hero)}</span>` +
          `<button type="button" class="sb-card-close" data-card-close aria-label="Close player card">×</button>` +
          `</div>` +
          `<div class="sb-card-stats">` +
          statChip("K", num(p.kills)) +
          statChip("D", num(p.deaths)) +
          statChip("A", num(p.assists)) +
          statChip("Gold", sum(p.total_gold)) +
          statChip("Net", sum(p.net_worth)) +
          statChip("LH/DN", lh) +
          statChip("GPM", num(p.gpm)) +
          statChip("XPM", num(p.xpm)) +
          statChip("Level", num(p.level)) +
          statChip("Hero dmg", sum(p.hero_damage)) +
          `</div>` +
          `<div class="sb-card-items">` +
          group("", p.items) +
          group("sb-slot-group--back", p.backpack) +
          group("", [p.neutral ?? null, p.neutral2 ?? null]) +
          `</div>`
        );
      }

      function setCard(sel: { side: "radiant" | "dire"; i: number } | null): void {
        cardSel = sel;
        const card = scoreboardEl.querySelector<HTMLElement>("[data-card]");
        if (!card) return;
        for (const tr of scoreboardEl.querySelectorAll<HTMLTableRowElement>("tr[data-side]")) {
          const on =
            sel !== null && tr.dataset.side === sel.side && Number(tr.dataset.i) === sel.i;
          tr.setAttribute("aria-pressed", String(on));
        }
        const p = sel && currentBoard ? currentBoard[sel.side][sel.i] : undefined;
        if (!sel || !p) {
          card.hidden = true;
          card.replaceChildren();
          return;
        }
        card.innerHTML = playerCardHtml(p, sel.side);
        card.hidden = false;
      }

      scoreboardEl.addEventListener("click", (e) => {
        if ((e.target as Element).closest("[data-card-close]")) {
          setCard(null);
          return;
        }
        const row = (e.target as Element).closest<HTMLElement>("tr[data-side]");
        if (!row) return;
        pickRow(row);
      });
      scoreboardEl.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setCard(null);
          return;
        }
        if (e.key !== "Enter" && e.key !== " ") return;
        const row = (e.target as Element).closest<HTMLElement>("tr[data-side]");
        if (!row) return;
        e.preventDefault();
        pickRow(row);
      });
      function pickRow(row: HTMLElement): void {
        const side = row.dataset.side as "radiant" | "dire";
        const i = Number(row.dataset.i);
        setCard(cardSel && cardSel.side === side && cardSel.i === i ? null : { side, i });
      }

      // --- The match body shared by every match: the fight view (the figure
      //     for a parsed match, the parse flow otherwise) and the item lanes ---

      // The tab bar rides on every match, parsed or not; the last picked view
      // is kept when a match reloads (e.g. a parse finishing under the tab).
      type TabView = "fights" | "items";
      let tabView: TabView = "fights";
      let itemsAbort: AbortController | null = null;

      function tabButton(view: TabView, label: string): HTMLButtonElement {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "app-tab";
        btn.setAttribute("role", "tab");
        btn.textContent = label;
        btn.addEventListener("click", () => {
          tabView = view;
          syncTabs(btn.closest(".app-tablist"));
        });
        return btn;
      }

      function syncTabs(list: Element | null): void {
        if (!list) return;
        const [fightsTab, itemsTab] = list.querySelectorAll<HTMLButtonElement>(".app-tab");
        const fightsPane = list.nextElementSibling as HTMLElement;
        const itemsPane = fightsPane.nextElementSibling as HTMLElement;
        for (const [btn, view] of [[fightsTab, "fights"], [itemsTab, "items"]] as const) {
          btn?.setAttribute("aria-selected", String(view === tabView));
        }
        fightsPane.hidden = tabView !== "fights";
        itemsPane.hidden = tabView !== "items";
      }

      async function showMatchBody(id: number, info: MatchInfo): Promise<void> {
        const ticket = matchSeq;
        const tablist = document.createElement("div");
        tablist.className = "app-tablist";
        tablist.setAttribute("role", "tablist");
        tablist.append(tabButton("fights", "Fights"), tabButton("items", "Items"));
        const fightsPane = document.createElement("div");
        const itemsPane = document.createElement("div");
        bodyEl.replaceChildren(tablist, fightsPane, itemsPane);
        syncTabs(tablist);
        if (info.parsed) void showFigure(id, fightsPane, ticket);
        else showUnparsed(id, info, fightsPane);
        void loadItems(id, info, itemsPane, ticket);
      }

      async function showFigure(id: number, pane: HTMLElement, ticket: number): Promise<void> {
        pane.replaceChildren(note("Loading fights…"));
        let index: FightsData;
        try {
          const res = await fetch(`/data/matches/${id}/fights/index.json`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          index = (await res.json()) as FightsData;
        } catch (err) {
          if (ticket !== matchSeq) return;
          pane.replaceChildren(note(`Could not load the fights: ${(err as Error).message}`));
          return;
        }
        if (ticket !== matchSeq) return;
        const [{ mountFightsFigure }, { fightDots }] = await Promise.all([
          import("../lib/fights-figure"),
          import("../lib/fights-data"),
        ]);
        if (ticket !== matchSeq) return;
        const figure = figureTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const assets = `/data/matches/${id}/figures/`;
        figure.dataset.assets = assets;
        figure.querySelector("image")!.setAttribute("href", `${assets}map.webp`);
        figure.querySelector<SVGGElement>("[data-fights]")!.innerHTML = fightDots(index.fights);
        const head = document.createElement("div");
        head.className = "fights-head";
        head.innerHTML =
          `<h2>Fights on the map</h2>` +
          `<p>Every fight in this match is a dot on the map. Bigger dots mean more deaths; the color shows which team got more kills in that fight. Click a dot or a row in the fight list to open that fight's breakdown below.</p>`;
        pane.replaceChildren(head, figure);
        mountFightsFigure(figure, index, {
          loadFight: (file) =>
            fetch(`/data/matches/${id}/${file}`)
              .then((r) => r.json())
              .then((j) => ({ default: j as FightData })),
          icons: null,
        });
      }

      async function loadItems(id: number, info: MatchInfo, pane: HTMLElement, ticket: number): Promise<void> {
        itemsAbort?.abort();
        const abort = new AbortController();
        itemsAbort = abort;
        pane.replaceChildren(note("Loading item timelines…"));
        let data: ItemLanesData;
        try {
          const res = await fetch(`/data/matches/${id}/items.json`, { signal: abort.signal });
          if (res.status === 404) {
            if (ticket !== matchSeq || abort.signal.aborted) return;
            showItemsMissing(id, info, pane);
            return;
          }
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          data = (await res.json()) as ItemLanesData;
        } catch (err) {
          if (ticket !== matchSeq || abort.signal.aborted) return;
          pane.replaceChildren(errorNote(`Could not load the item timelines: ${(err as Error).message}`));
          return;
        }
        if (ticket !== matchSeq || abort.signal.aborted) return;
        const { mountItems } = await import("../lib/items-lanes");
        if (ticket !== matchSeq || abort.signal.aborted) return;
        mountItems(pane, data);
      }

      function showItemsMissing(id: number, info: MatchInfo, pane: HTMLElement): void {
        const box = document.createElement("section");
        box.className = "parse-panel";
        const action = info.parsed
          ? `<p class="app-note">This match was parsed before item timelines were added, and OpenDota has no purchase log for it, so there are no purchases on file.</p>`
          : `<p class="app-note">Purchases come from the replay's own records, and OpenDota hasn't published its purchase log for this match (if it ever does, they show up without a parse). Parsing this replay builds them now.</p>` +
            `<p><button type="button" class="button button--primary" data-parse>Parse replay</button></p>`;
        box.innerHTML =
          `<h2>Item timelines</h2>` + action;
        const view = document.createElement("div");
        box.append(view);
        const parseBtn = box.querySelector<HTMLButtonElement>("[data-parse]");
        parseBtn?.addEventListener("click", () => void startParse(id, view));
        pane.replaceChildren(box);
      }

      // --- Unparsed: the parse button, the progress, the log ---

      function showUnparsed(id: number, info: MatchInfo, pane: HTMLElement): void {
        pane.replaceChildren();
        const panel = document.createElement("section");
        panel.className = "parse-panel";
        panel.innerHTML =
          `<h2>Not parsed yet</h2>` +
          `<p class="app-note">This match has no fight breakdown on disk. Parsing downloads the replay and builds one; the raw replay is deleted after a successful parse.</p>` +
          (info.parse_error ? `<p class="app-error">${text(info.parse_error)}</p>` : "") +
          `<p><button type="button" class="button button--primary" data-parse>Parse replay</button></p>` +
          `<div data-parse-view></div>`;
        const view = panel.querySelector<HTMLElement>("[data-parse-view]")!;
        panel.querySelector<HTMLButtonElement>("[data-parse]")!.addEventListener("click", () => void startParse(id, view));
        pane.append(panel);
      }

      async function startParse(id: number, view: HTMLElement): Promise<void> {
        const ticket = matchSeq;
        view.replaceChildren(note("Starting…"));
        let res: Response;
        try {
          res = await fetch(`/api/parse/${id}`, { method: "POST" });
        } catch (err) {
          if (ticket !== matchSeq) return;
          view.replaceChildren(errorNote(`Could not reach the server: ${(err as Error).message}`));
          return;
        }
        if (ticket !== matchSeq) return;
        const body = (await res.json().catch(() => ({}))) as { status?: string };
        if (res.status === 202 || (res.status === 409 && body.status === "already_running")) {
          watchParse(id, view, ticket);
          return;
        }
        if (res.status === 409 && body.status === "already_parsed") {
          view.replaceChildren(note("Already parsed — loading…"));
          void loadMatch(id);
          return;
        }
        const msg =
          res.status === 404
            ? "No replay is available for this match — it may have expired."
            : res.status === 502
              ? `OpenDota lookup failed${body.status ? ` (${body.status})` : ""}.`
              : `Parse request failed (HTTP ${res.status}${body.status ? `: ${body.status}` : ""}).`;
        view.replaceChildren(errorNote(msg));
      }

      function watchParse(id: number, view: HTMLElement, ticket: number): void {
        stopPoll();
        view.replaceChildren();
        const bar = document.createElement("div");
        bar.className = "parse-bar is-indeterminate";
        bar.innerHTML = `<div class="parse-bar-fill"></div>`;
        const stage = document.createElement("p");
        stage.className = "parse-stage";
        stage.textContent = "queued";
        const log = document.createElement("pre");
        log.className = "parse-log";
        log.setAttribute("aria-label", "Parse log");
        view.append(bar, stage, log);
        let busy = false;
        const tick = async () => {
          if (busy) return;
          busy = true;
          try {
            const res = await fetch(`/api/parse/${id}/status?${bust()}`);
            if (ticket !== matchSeq) {
              stopPoll();
              return;
            }
            if (!res.ok) {
              stopPoll();
              view.replaceChildren(errorNote(`Parse status unavailable (HTTP ${res.status}).`), log);
              return;
            }
            const st = (await res.json()) as ParseStatus;
            if (ticket !== matchSeq) {
              stopPoll();
              return;
            }
            stage.textContent = `${st.stage}${st.pct === null ? "" : ` · ${Math.round(st.pct)}%`}`;
            const fill = bar.firstElementChild as HTMLElement;
            if (st.pct === null) {
              bar.classList.add("is-indeterminate");
              fill.removeAttribute("style");
            } else {
              bar.classList.remove("is-indeterminate");
              fill.style.width = `${Math.min(100, Math.max(0, st.pct))}%`;
            }
            log.textContent = st.log.join("\n");
            log.scrollTop = log.scrollHeight;
            if (st.done) {
              stopPoll();
              rowStates.set(id, true);
              updateRowState(id);
              void loadMatch(id);
            } else if (st.error) {
              stopPoll();
              const box = document.createElement("div");
              box.className = "parse-failed";
              box.append(errorNote(st.error), log);
              view.replaceChildren(box);
            }
          } catch {
            // A transient fetch failure just waits for the next tick.
            if (ticket !== matchSeq) stopPoll();
          } finally {
            busy = false;
          }
        };
        pollTimer = setInterval(() => void tick(), 1000);
        void tick();
      }

      // Auto-load: a shared ?m= selects immediately (the list fills in around
      // it); otherwise wait for the list to know which match is newest.
      const initialId = paramId();
      if (initialId !== null) selectMatch(initialId);
      void loadList();
    </script>
