        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .sb-table td {
        padding: 4px 5px;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        white-space: nowrap;
        vertical-align: middle;
      }
      .sb-table .num {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .sb-player {
        overflow: hidden;
        color: var(--body);
        text-overflow: ellipsis;
      }
      .sb-hero {
        overflow: hidden;
      }
      .sb-hero span {
        /* The hero icon (24px + its 6px margin) sits aside of it. */
        display: inline-block;
        max-width: calc(100% - 30px);
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        white-space: nowrap;
      }
      .sb-icon {
        width: 24px;
        height: 24px;
        margin-right: 6px;
        border: 1.5px solid;
        border-radius: 50%;
        object-fit: cover;
        vertical-align: middle;
      }
      .sb-icon--radiant {
        border-color: var(--map-radiant-mark);
      }
      .sb-icon--dire {
        border-color: var(--map-dire-mark);
      }
      .sb-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 6px 18px;
        margin: 0 0 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
        font-size: 13.5px;
      }
      .sb-when {
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .sb-meta {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .sb-dur {
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .sb-score {
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 15px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }
      .sb-winner {
        padding: 1px 8px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-family: var(--font-sans);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .tag-turbo {
        padding: 1px 8px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
      }
      .sb-error {
        margin: 0;
        color: var(--muted);
        font-size: 13.5px;
      }

      /* Clickable scoreboard rows and the player card they open */
      .sb-table tr[data-side] {
        cursor: pointer;
      }
      /* Row states, mixed against --accent directly (--accent-soft is already
         a ~0.1-alpha color, so mixing it again reads as nothing): plain rows
         lift to 8% under the cursor; squad rows rest at 12%, lift to 20%, and
         a picked row of either kind reads at 25%. */
      .sb-table tr[data-side].sb-squad td {
        background: color-mix(in srgb, var(--accent) 12%, transparent);
      }
      .sb-table tr[data-side]:hover td {
        background: color-mix(in srgb, var(--accent) 8%, transparent);
      }
      .sb-table tr[data-side].sb-squad:hover td {
        background: color-mix(in srgb, var(--accent) 20%, transparent);
      }
      .sb-table tr[data-side][aria-pressed="true"] td {
        background: color-mix(in srgb, var(--accent) 25%, transparent);
      }
      .sb-table tr[data-side]:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
      /* The small squad label beside a highlighted player card's name. */
      .sb-tag-squad {
        padding: 1px 8px;
        border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
        border-radius: 999px;
        color: var(--accent);
        font-family: var(--font-sans);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .sb-card {
        margin-top: 16px;
        padding: 14px 16px;
        border: 1px solid var(--rule);
        border-radius: 8px;
        background: var(--paper);
        box-shadow: var(--shadow);
      }
      .sb-card-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--line);
      }
      .sb-card-name {
        color: var(--ink);
        font-size: 15px;
        font-weight: 600;
      }
      .sb-card-hero {
        color: var(--muted);
        font-size: 13px;
      }
      .sb-card-close {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        margin-left: auto;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: none;
        color: var(--muted);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
      }
      .sb-card-close:hover {
        border-color: var(--rule);
        color: var(--ink);
      }
      .sb-card-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        margin: 12px 0;
      }
      .sb-stat {
        display: inline-flex;
        align-items: baseline;
        gap: 5px;
      }
      .sb-stat b {
        color: var(--ink);
        font-size: 15px;
        font-variant-numeric: tabular-nums;
      }
      .sb-stat i {
        color: var(--muted);
        font-size: 10.5px;
        font-style: normal;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .sb-card-items {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 14px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }
      .sb-slot-group {
        display: inline-flex;
        gap: 4px;
      }
      .sb-slot-group--back .sb-slot {
        opacity: 0.7;
      }
      .sb-slot {
        display: block;
        width: 32px;
        height: 32px;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: var(--bg);
        object-fit: contain;
      }
      .sb-slot--empty {
        border-style: dashed;
        background: none;
      }
      /* The neutral group sits last; its items get an accent edge. */
      .sb-slot-group:last-child .sb-slot:not(.sb-slot--empty) {
        border-color: var(--accent);
      }

      /* The unparsed panel is the same full-width card the fights figure is: a
         parsed match and an unparsed one keep the same content width, and the
         same left edge, when the reader switches between them. */
      .parse-panel {
        margin: 0;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: var(--paper);
        box-shadow: var(--shadow);
      }
      .parse-panel h2 {
        margin: 0 0 10px;
        color: var(--ink);
        font-family: var(--font-serif);
        font-size: 28px;
        font-weight: 450;
      }
      .parse-panel .app-note {
        max-width: 720px;
        margin: 0 0 18px;
      }
      .parse-panel [data-parse-view] {
        margin-top: 18px;
      }
      .parse-bar {
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: var(--line);
      }
      .parse-bar-fill {
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: var(--accent);
      }
      .parse-bar.is-indeterminate .parse-bar-fill {
        width: 100%;
        background: linear-gradient(90deg, transparent 15%, var(--accent) 50%, transparent 85%);
        background-size: 200% 100%;
        animation: parse-shimmer 1.4s ease-in-out infinite;
      }
      @keyframes parse-shimmer {
        from {
          background-position: 120% 0;
        }
        to {
          background-position: -120% 0;
        }
      }
      .parse-stage {
        margin: 10px 0 0;
        color: var(--muted);
        font-size: 13px;
      }
      .parse-log {
        max-height: 260px;
        margin: 12px 0 0;
        padding: 10px 12px;
        overflow-y: auto;
        border: 1px solid var(--code-border);
        border-radius: 6px;
        background: var(--code-bg);
        color: var(--code-fg);
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.6;
        text-align: left;
        white-space: pre-wrap;
        word-break: break-word;
      }
      .spinner {
        display: inline-block;
        width: 11px;
        height: 11px;
        border: 2px solid var(--line);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        vertical-align: -1px;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .fights-head {
        margin: 0 0 18px;
      }
      .fights-head h2 {
        margin: 0;
        color: var(--ink);
        font-family: var(--font-serif);
        font-size: 20px;
        font-weight: 450;
      }
      .fights-head p {
        max-width: 720px;
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14.5px;
        line-height: 1.55;
      }
      .fights-head + .fights-fig {
        margin-top: 0;
      }

      /* The tab bar over a parsed match's views */
      .app-tablist {
        display: flex;
        gap: 18px;
        margin: 0 0 18px;
        border-bottom: 1px solid var(--rule);
      }
      .app-tab {
        padding: 6px 2px;
        margin-bottom: -1px;
        border: 0;
        border-bottom: 2px solid transparent;
        background: none;
        color: var(--muted);
        font: inherit;
        font-size: 14.5px;
        cursor: pointer;
      }
      .app-tab:hover {
        color: var(--ink);
      }
      .app-tab[aria-selected="true"] {
        border-bottom-color: var(--accent);
        color: var(--ink);
        font-weight: 600;
      }

      /* Item timelines: one lane per player on a shared game clock */
      .items-frame {
        position: relative;
        --label-w: 170px;
        --horn-x: 0%;
      }
      /* The ruler sticks to the top of the window so the times stay readable
         while scrolling the lanes. */
      .items-ruler {
        position: sticky;
        top: 0;
        z-index: 3;
        border-bottom: 1px solid var(--rule);
        background: var(--bg);
      }
      .items-ruler,
      .items-row {
        display: grid;
        grid-template-columns: var(--label-w) minmax(0, 1fr);
      }
      .items-ruler-track {
        position: relative;
        height: 24px;
      }
      .items-tick {
        position: absolute;
        top: 0;
        width: 1px;
        height: 7px;
        background: var(--line);
      }
      .items-tick-label {
        position: absolute;
        top: 9px;
        transform: translateX(2px);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 10px;
        white-space: nowrap;
      }
      .items-lanes {
        position: relative;
        margin-top: 6px;
      }
      /* Vertical lines at the ruler's ticks, behind the lanes. */
      .items-grid {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: var(--label-w);
        pointer-events: none;
      }
      .items-grid-line,
      .items-grid-horn {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
      }
      .items-grid-line {
        background: var(--line);
      }
      .items-grid-horn {
        background: var(--rule);
      }
      .items-team {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 10px 0 2px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--rule);
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-serif);
        font-size: 15px;
        font-weight: 450;
      }
      .items-team::before {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        content: "";
      }
      .items-team--radiant::before {
        background: var(--map-radiant-mark);
      }
      .items-team--dire::before {
        background: var(--map-dire-mark);
      }
      .items-row {
        align-items: center;
      }
      .items-label {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
        padding: 3px 8px 3px 0;
      }
      .lane-hero {
        flex: none;
        width: 26px;
        height: 26px;
        border: 1.5px solid;
        border-radius: 50%;
        object-fit: cover;
      }
      .lane-hero--radiant {
        border-color: var(--map-radiant-mark);
      }
      .lane-hero--dire {
        border-color: var(--map-dire-mark);
      }
      .lane-name {
        max-width: 82px;
        overflow: hidden;
        color: var(--body);
        font-size: 12.5px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .lane-hero-name {
        overflow: hidden;
        color: var(--muted);
        font-size: 11px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .items-lane {
        position: relative;
        min-height: 24px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(90deg, var(--accent-soft) 0, var(--accent-soft) var(--horn-x), transparent var(--horn-x));
      }
      .lane-item {
        position: absolute;
        display: flex;
        align-items: center;
        height: 16px;
      }
      .lane-item-icon {
        display: block;
        border-radius: 3px;
        cursor: help;
      }
      .lane-item-count {
        margin-left: 1px;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 9.5px;
        font-style: normal;
      }
      .lane-item-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--line);
      }
      .lane-tip {
        position: absolute;
        z-index: 4;
        padding: 4px 9px;
        border: 1px solid var(--rule);
        border-radius: 6px;
        background: var(--paper);
        box-shadow: var(--shadow);
        color: var(--ink);
        font-size: 12.5px;
        white-space: nowrap;
        pointer-events: none;
      }

      @media (max-width: 700px) {
        .items-frame {
          --label-w: 110px;
        }
        .lane-hero-name {
          display: none;
        }
      }

      /* This page has no fights-fig-side card: the map takes the figure's full
         width (figures.css's :has() rule only matches a hidden side child). */
      .fights-fig-body:not(:has(> .fights-fig-side)) {
        grid-template-columns: minmax(0, 1fr);
      }

      /* Two boards side by side only fit once the main column is at its
         full width (viewport >= 1400px, sidebar included). Narrower than
         that — square-ish windows especially — the half-width tracks are
         smaller than a table's minimum and the text collides, so stack. */
      @media (max-width: 1399px) {
        .sb-teams {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 900px) {
        .app {
          grid-template-columns: minmax(0, 1fr);
          gap: 24px;
          padding: 20px 16px 64px;
        }
        .app-side {
          position: static;
          max-height: 340px;
        }
      }
    </style>
  </body>
</html>
