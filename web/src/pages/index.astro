        pointer-events: none;
      }

      @media (max-width: 700px) {
        .items-frame {
          --label-w: 110px;
        }
        .lane-hero-name {
          display: none;
        }
      }

      /* This page has no fights-fig-side card: the map takes the figure's full
         width (figures.css's :has() rule only matches a hidden side child). */
      .fights-fig-body:not(:has(> .fights-fig-side)) {
        grid-template-columns: minmax(0, 1fr);
      }

      @media (max-width: 900px) {
        .app {
          grid-template-columns: minmax(0, 1fr);
          gap: 24px;
          padding: 20px 16px 64px;
        }
        .app-side {
          position: static;
          max-height: 340px;
        }
        .sb-teams {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>
  </body>
</html>
